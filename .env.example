# ==============================================
# OpenClaw Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ==============================================
# AI Provider Keys (OpenRouter)
# ==============================================
OPENROUTER_API_KEY=
SYSTEM_OPENROUTER_KEY=

# ==============================================
# Gateway Configuration
# ==============================================
GATEWAY_PORT=18789
GATEWAY_BIND=lan
GATEWAY_TOKEN=

# ==============================================
# AWS Credentials (for ECS/Docker deployment)
# ==============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ==============================================
# AWS ECS Configuration
# ==============================================
ECS_CLUSTER_NAME=openclaw-cluster
ECS_SERVICE_NAME=openclaw-service
ECS_CONTAINER_NAME=openclaw

# ==============================================
# Channel Credentials (fill as needed)
# ==============================================
# WhatsApp
WHATSAPP_SESSION_FILE=

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_SIGNING_SECRET=

# ==============================================
# Database (optional)
# ==============================================
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=openclaw
DATABASE_USER=
DATABASE_PASSWORD=

# ==============================================
# Redis (optional, for session/caching)
# ==============================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# S3 Configuration (for file storage)
# ==============================================
S3_BUCKET_NAME=
AWS_S3_REGION=ap-south-1

# ==============================================
# Secrets Manager
# ==============================================
SECRETS_MANAGER_REGION=ap-south-1

# ==============================================
# EFS Configuration
# ==============================================
EFS_FILESYSTEM_ID=
EFS_MOUNT_POINT=/home/node/.openclaw

# ==============================================
# CloudFront (if using CDN)
# ==============================================
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=

# ==============================================
# Basic Auth (for Control UI)
# ==============================================
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=

# ==============================================
# Web Search (optional)
# ==============================================
BRAVE_SEARCH_API_KEY=

# ==============================================
# OAuth (for Claude Code/Anthropic)
# ==============================================
ANTHROPIC_CLIENT_ID=
ANTHROPIC_CLIENT_SECRET=
ANTHROPIC_DEVICE_CODE=
